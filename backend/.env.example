ENV=development

# Ordinary request path — RLS-bound poko_app role.
DATABASE_URL=postgresql+psycopg://poko_app:poko_app@localhost:5432/poko
# Platform support-access path only (BYPASSRLS) — never used for ordinary requests.
DATABASE_URL_BYPASS=postgresql+psycopg://poko_bypass:poko_bypass@localhost:5432/poko
# Alembic + one-off scripts (create_admin/seed_demo) — needs table-owner privileges.
DATABASE_URL_MIGRATE=postgresql+psycopg://poko:poko@localhost:5432/poko

JWT_SECRET=dev-insecure-secret-change-me
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=30

REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:3000
